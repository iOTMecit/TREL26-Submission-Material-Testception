#!/usr/bin/env python3
"""Create a Selenium 4 + JUnit 4 coverage-aware suite from raw RLM output."""

from pathlib import Path
import re
import sys

if len(sys.argv) != 3:
    raise SystemExit(
        "Usage: instrument_generated_suite.py "
        "<raw GeneratedTestSuiteFired.java> "
        "<selenium4 project root>"
    )

source = Path(sys.argv[1]).resolve()
project = Path(sys.argv[2]).resolve()
output = (
    project
    / "src"
    / "test"
    / "java"
    / "tests"
    / "GeneratedTestSuiteFiredTest.java"
)

text = source.read_text(encoding="utf-8")

# Remove legacy DANTE execution helpers.
for legacy_import in (
    "import utils.DriverProvider;\n",
    "import utils.Properties;\n",
    "import utils.BasePageObject;\n",
):
    text = text.replace(legacy_import, "")

# Selenium 4 / JUnit watcher imports.
anchor = "import org.openqa.selenium.support.ui.Select;\n"
replacement = """import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;
import org.openqa.selenium.chromium.HasCdp;
import org.junit.Rule;
import org.junit.AssumptionViolatedException;
import org.junit.rules.TestWatcher;
import org.junit.runner.Description;
import coverage.Selenium4JsCoverage;
"""
text = text.replace(anchor, replacement, 1)

text = text.replace(
    "public class GeneratedTestSuiteFired {",
    "public class GeneratedTestSuiteFiredTest {",
    1,
)

text = text.replace(
    "\tprivate static BasePageObject basePageObject;\n",
    "",
)

text = text.replace(
    "\tprivate static WebDriver driver;\n",
    """\tprivate static WebDriver driver;
\tprivate static Selenium4JsCoverage jsCoverage;

\t@Rule
\tpublic final TestWatcher coverageWatcher = new TestWatcher() {
\t\tprivate String name(Description description) {
\t\t\treturn description.getClassName()
\t\t\t\t+ "#"
\t\t\t\t+ description.getMethodName();
\t\t}

\t\t@Override
\t\tprotected void starting(Description description) {
\t\t\tjsCoverage.beginTest(name(description));
\t\t}

\t\t@Override
\t\tprotected void succeeded(Description description) {
\t\t\tjsCoverage.endTest(name(description), true);
\t\t}

\t\t@Override
\t\tprotected void failed(
\t\t\t\tThrowable error,
\t\t\t\tDescription description) {
\t\t\ttry {
\t\t\t\tjsCoverage.endTest(name(description), false);
\t\t\t} catch (RuntimeException coverageError) {
\t\t\t\terror.addSuppressed(coverageError);
\t\t\t}
\t\t}

\t\t@Override
\t\tprotected void skipped(
\t\t\t\tAssumptionViolatedException error,
\t\t\t\tDescription description) {
\t\t\tjsCoverage.abortTest(name(description), "SKIPPED");
\t\t}

\t\t@Override
\t\tprotected void finished(Description description) {
\t\t\tjsCoverage.abortTest(name(description), "ABORTED");
\t\t}
\t};
""",
    1,
)

old_driver_setup = "\t\tdriver = DriverProvider.getInstance().getDriver();\n"
new_driver_setup = """\t\tChromeOptions options = new ChromeOptions();
\t\tboolean headless = Boolean.parseBoolean(
\t\t\tSystem.getenv().getOrDefault(
\t\t\t\t"TESTCEPTION_HEADLESS",
\t\t\t\t"false")
\t\t);
\t\tif (headless) {
\t\t\toptions.addArguments("--headless=new");
\t\t}
\t\toptions.addArguments("--remote-allow-origins=*");
\t\tdriver = new ChromeDriver(options);

\t\tif (!(driver instanceof HasCdp)) {
\t\t\tthrow new IllegalStateException(
\t\t\t\t"Active Chrome driver does not implement HasCdp");
\t\t}

\t\tjsCoverage = Selenium4JsCoverage.fromEnvironment(
\t\t\t(HasCdp) driver);
\t\tjsCoverage.start();
"""
text = text.replace(
    old_driver_setup,
    new_driver_setup,
    1,
)

text = text.replace(
    "\t\tbasePageObject = new BasePageObject(driver);\n",
    "",
)

# Empty locator is a real generated-test failure.
text = text.replace(
    "\tif (xpath == null || xpath.trim().isEmpty()) return;\n",
    """\tif (xpath == null || xpath.trim().isEmpty()) {
\t\tthrow new IllegalArgumentException("Empty click XPath");
\t}\n""",
    1,
)

# Do not make failed generated actions look like passing JUnit tests.
step_pattern = re.compile(
    r'\} catch \(Exception e\) \{ '
    r'System\.out\.println\("STEP_SKIPPED: ([^"]*)"\); '
    r'\}'
)

def strict_step(match: re.Match[str]) -> str:
    locator = match.group(1)
    return (
        '} catch (Exception e) { '
        f'System.out.println("STEP_FAILED: {locator} | " + e); '
        'throw e; }'
    )

text, replacement_count = step_pattern.subn(
    strict_step,
    text,
)

if replacement_count == 0:
    raise SystemExit(
        "No STEP_SKIPPED blocks were found; "
        "raw suite format may have changed."
    )

old_teardown = """\t@AfterClass
\tpublic static void tearDown() throws Exception {
\t\ttry {
\t\t\tif (driver != null) driver.quit();
\t\t} catch (Exception e) {}
\t}
}
"""

new_teardown = """\t@AfterClass
\tpublic static void tearDown() throws Exception {
\t\tRuntimeException coverageFailure = null;

\t\ttry {
\t\t\tif (jsCoverage != null) {
\t\t\t\tjsCoverage.closeAndWrite();
\t\t\t}
\t\t} catch (RuntimeException e) {
\t\t\tcoverageFailure = e;
\t\t}

\t\ttry {
\t\t\tif (driver != null) {
\t\t\t\tdriver.quit();
\t\t\t}
\t\t} finally {
\t\t\tif (coverageFailure != null) {
\t\t\t\tthrow coverageFailure;
\t\t\t}
\t\t}
\t}
}
"""

if old_teardown not in text:
    raise SystemExit(
        "Expected generated @AfterClass block was not found."
    )

text = text.replace(
    old_teardown,
    new_teardown,
    1,
)

output.parent.mkdir(
    parents=True,
    exist_ok=True,
)

output.write_text(
    text,
    encoding="utf-8",
)

print(
    "Instrumented suite:",
    output,
)
print(
    "Strict STEP_FAILED conversions:",
    replacement_count,
)
